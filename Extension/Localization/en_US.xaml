<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    
    <!-- Library Sync -->
    <sys:String x:Key="LOC_SyncOperation_CanceledByUser">Game library sychronization with PlayAtlas was canceled.</sys:String>
    <sys:String x:Key="LOC_Loading_SyncClientServer">Syncing game library with PlayAtlas server...</sys:String>
    <sys:String x:Key="LOC_Failed_SyncGameLibrary">Unexpected error while syncing games library</sys:String>
    <sys:String x:Key="LOC_Success_SyncClientServer">Synchronization with PlayAtlas server completed successfully.</sys:String>
    <sys:String x:Key="LOC_Success_SyncGameLibrary">Game library synchronization with PlayAtlas server completed successfully.</sys:String>
    <sys:String x:Key="LOC_Success_SyncMediaFiles">Library media files synchronization with PlayAtlas server completed successfully.</sys:String>
    <sys:String x:Key="LOC_Progress_SyncingMediaFiles">Syncing media files with PlayAtlas server, {{current}} of {{total}}: {{gameName}}</sys:String>
    <sys:String x:Key="LOC_Progress_SyncingGames">Syncing {{total}} games with PlayAtlas server</sys:String>

    <sys:String x:Key="LOC_Success_Extension_Registration">Extension registration was requested. Approve it in the PlayAtlas UI.</sys:String>
    <sys:String x:Key="LOC_Failed_Extension_Registration">Failed to register the extension. Check logs for details.</sys:String>
    
    <!-- Settings -->
    <sys:String x:Key="LOC_Label_WebServerURL">PlayAtlas Web Server URL</sys:String>
    <sys:String x:Key="LOC_Label_EnableLibrarySyncOnUpdate">Sync games database with server on library update</sys:String>
    <sys:String x:Key="LOC_Label_EnableMediaFilesSyncOnUpdate">Sync library media files with server on library update</sys:String>
    <sys:String x:Key="LOC_Label_ManualSync">Run Manual Sync</sys:String>
    <sys:String x:Key="LOC_Label_MenuItem_ManualSync">PlayAtlas Manual Sync</sys:String>
    <sys:String x:Key="LOC_Label_ShareX_Executable_Path">ShareX executable path</sys:String>
    <sys:String x:Key="LOC_Label_RegisterExtension">Register Extension</sys:String>
    
    <!-- Library Statistics Exporter -->
    <sys:String x:Key="LOC_Label_ExportLibraryStats">Export Library Stats</sys:String>
    
    <!-- Failure -->
</ResourceDictionary>