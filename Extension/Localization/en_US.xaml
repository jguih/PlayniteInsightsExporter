<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="LOC_Loading_SyncClientServer">Syncing library with server...</sys:String>
    <sys:String x:Key="LOC_Failed_SyncClientServer">
        Failed to sync your library with PlayAtlas.
        Make sure your PlayAtlas server is reachable and the extension is registered and trusted. Check logs for more details.
    </sys:String>
    <sys:String x:Key="LOC_Failed_SyncMediaFiles">
        Failed to sync your media files with PlayAtlas.
        Make sure your PlayAtlas server is reachable and the extension is registered and trusted. Check logs for more details.
    </sys:String>
    <sys:String x:Key="LOC_Failed_SyncSessions">
        Failed to sync your game sessions with PlayAtlas.
        Make sure your PlayAtlas server is reachable and the extension is registered and trusted. Check logs for more details.
    </sys:String>
    <sys:String x:Key="LOC_Success_SyncClientServer">Library successfully synced with PlayAtlas.</sys:String>
    <sys:String x:Key="LOC_Success_Extension_Registration">Extension registration was requested. Approve it in the PlayAtlas UI.</sys:String>
    <sys:String x:Key="LOC_Failed_Extension_Registration">Failed to register the extension. Check logs for details.</sys:String>
    
    <!-- Labels -->
    <sys:String x:Key="LOC_Label_WebServerURL">PlayAtlas Web Server URL</sys:String>
    <sys:String x:Key="LOC_Label_EnableLibrarySyncOnUpdate">Sync games database with server on library update</sys:String>
    <sys:String x:Key="LOC_Label_EnableMediaFilesSyncOnUpdate">Sync library media files with server on library update</sys:String>
    <sys:String x:Key="LOC_Label_ManualSync">Run Manual Sync</sys:String>
    <sys:String x:Key="LOC_Label_MenuItem_ManualSync">PlayAtlas Manual Sync</sys:String>
    <sys:String x:Key="LOC_Label_ShareX_Executable_Path">ShareX executable path</sys:String>
    <sys:String x:Key="LOC_Label_PlayAtlasServer_PubKey_Path">PlayAtlas Server public key path</sys:String>
    <sys:String x:Key="LOC_Label_Browse">Browse</sys:String>
    <sys:String x:Key="LOC_Label_HttpServer_Port">Port: </sys:String>
    <sys:String x:Key="LOC_Label_HttpServer_Start_On_App_Startup">Start Server on Application Startup</sys:String>
    <sys:String x:Key="LOC_Label_HttpServer_Reserve_Port">Reserve Port</sys:String>
    <sys:String x:Key="LOC_Label_HttpServer_Start_Server">Start Server</sys:String>
    <sys:String x:Key="LOC_Label_HttpServer_Stop_Server">Stop Server</sys:String>
    <sys:String x:Key="LOC_Label_HttpServer_Server_Is_Running_Status_Text">Server is running and listening on port {{port}}</sys:String>
    <sys:String x:Key="LOC_Label_HttpServer_Server_Is_Not_Running_Status_Text">Server is not running</sys:String>
    <sys:String x:Key="LOC_Label_HttpServer_Get_Pub_File_Command">Run this command in the Docker host to copy the server's public key file:</sys:String>

    <!-- Failure -->
    <sys:String x:Key="LOC_Label_HttpServer_Failed_To_Start">Failed to start HTTP server. The chosen port should be reserved for current user. Check extension logs.</sys:String>
    <sys:String x:Key="LOC_Label_HttpServer_Failed_To_Stop">Failed to stop HTTP server. Check extension logs.</sys:String>
    
    <!--Progress-->
    <sys:String x:Key="LOC_Progress_SyncingMediaFiles">Syncing media files {{current}} of {{total}}: {{gameName}}</sys:String>
    <sys:String x:Key="LOC_Progress_SyncingGames">Syncing {{total}} games with PlayAtlas server</sys:String>
</ResourceDictionary>